<Window x:Class="MemoryObjectModelSample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MemoryObjectModelSample"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel>
            <Button Content="String Object" x:Name="StringBtn" Click="StringBtn_Click" />
            <Button Content="class Object" x:Name="ClassBtn" Click="ClassBtn_Click" />
            <Button Content="Array Object" x:Name="ArrayBtn" Click="ArrayBtn_Click" />
            <Button Content="List Object" x:Name="ListBtn" Click="ListBtn_Click" />
            <Button Content="Dictionary Object" x:Name="DictionaryBtn" Click="DictionaryBtn_Click" />
        </StackPanel>
    </Grid>
</Window>
