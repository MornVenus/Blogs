<Window x:Class="ArrayPoolSample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ArrayPoolSample"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel>
            <Button x:Name="LargeBytesReturnBtn" Content="Large Bytes Return" Click="LargeBytesReturnBtn_Click" />
            <Button x:Name="ReturnCustomBytesBtn" Content="Return Custom Bytes" Click="ReturnCustomBytesBtn_Click" />
            <Button x:Name="ThreadLocalBtn" Content="Thread Local" Click="ThreadLocalBtn_Click" />
        </StackPanel>
    </Grid>
</Window>
